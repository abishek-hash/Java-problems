import java.util.*;
public class Largest
{
  public static void findmax(int arr[],int n){
  int max=arr[0];
  int index=0;
  for(int i=0;i<n;i++){
      if(max<arr[i]){
        max=arr[i];
        index=i;
      }
    }
System.out.println("Maximum Number is: "+max+" At Present the Index: "+index);
  }
  public static void main(String[]args){
    Scanner sc=new Scanner(System.in);
    int n=sc.nextInt();
    int arr[]=new int[n];

    for(int i=0;i<n;i++){
      arr[i]=sc.nextInt();
    }
    findmax(arr,n);
    
  }  

}
